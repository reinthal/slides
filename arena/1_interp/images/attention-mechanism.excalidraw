        ]
      ],
      "lastCommittedPoint": null,
      "startBinding": null,
      "endBinding": null,
      "startArrowhead": null,
      "endArrowhead": "arrow",
      "elbowed": false
    },
    {
      "id": "el0116",
      "type": "text",
      "x": 40,
      "y": 840,
      "width": 524.7,
      "height": 315.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 649187325,
      "version": 1,
      "versionNonce": 1998679711,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786536832141,
      "link": null,
      "locked": false,
      "text": "We get attention scores by taking the inner product\nof keys and queries along the head dimension. This\ngives us matrices of shape (seq, seq) for each head.\nThen we softmax over the k-dimension to get attn probs.\n\nAttn probs tell us how much each query position\n(destination) pays attention to each key position\n(source), i.e. this tells us where information moves\nto and from.\n\nWe make sure no information flows backwards by\nsetting the attention scores to be -1e5 wherever\nquery posn < key posn (so the corresponding attn\nprobs are zero).",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We get attention scores by taking the inner product\nof keys and queries along the head dimension. This\ngives us matrices of shape (seq, seq) for each head.\nThen we softmax over the k-dimension to get attn probs.\n\nAttn probs tell us how much each query position\n(destination) pays attention to each key position\n(source), i.e. this tells us where information moves\nto and from.\n\nWe make sure no information flows backwards by\nsetting the attention scores to be -1e5 wherever\nquery posn < key posn (so the corresponding attn\nprobs are zero).",
      "lineHeight": 1.25,
      "baseline": 18
    },
