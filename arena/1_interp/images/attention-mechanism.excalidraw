    },
    {
      "id": "el0112",
      "type": "text",
      "x": 40,
      "y": 330,
      "width": 505.62,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1700113407,
      "version": 1,
      "versionNonce": 1989259376,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786536832141,
      "link": null,
      "locked": false,
      "text": "We apply a final linear transformation to our value\nvectors, mapping them up to the right size to be\nadded to the residual stream.\n\nThis is a linear map from size h -> e, for each head.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We apply a final linear transformation to our value\nvectors, mapping them up to the right size to be\nadded to the residual stream.\n\nThis is a linear map from size h -> e, for each head.",
      "lineHeight": 1.25,
      "baseline": 18
    },
    {
      "id": "el0113",
      "type": "arrow",
      "x": 690,
      "y": 350,
      "width": 660,
      "height": 50,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1723943247,
      "version": 1,
      "versionNonce": 364725392,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786536832141,
      "link": null,
      "locked": false,
      "points": [
